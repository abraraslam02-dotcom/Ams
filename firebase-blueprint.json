{
  "entities": {
    "CloudSnapshotMeta": {
      "title": "Cloud Snapshot Metadata",
      "description": "Metadata for the authoritative SQLite database snapshot persisted to Firebase Firestore across container deployments",
      "type": "object",
      "properties": {
        "snapshotKey": { "type": "string" },
        "syncKey": { "type": "string" },
        "checksum": { "type": "string" },
        "fileSizeBytes": { "type": "number" },
        "compressedSizeBytes": { "type": "number" },
        "chunkCount": { "type": "number" },
        "totalChunks": { "type": "number" },
        "rowCount": { "type": "number" },
        "exportedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["snapshotKey", "syncKey", "checksum", "updatedAt"]
    },
    "CloudSnapshotChunk": {
      "title": "Cloud Snapshot Chunk",
      "description": "Base64 gzipped chunk of the SQLite database snapshot",
      "type": "object",
      "properties": {
        "snapshotKey": { "type": "string" },
        "syncKey": { "type": "string" },
        "chunkIndex": { "type": "number" },
        "totalChunks": { "type": "number" },
        "checksum": { "type": "string" },
        "data": { "type": "string" },
        "dataBase64": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["snapshotKey", "syncKey", "chunkIndex", "updatedAt"]
    },
    "ConnectionProbe": {
      "title": "Firestore Connection Probe",
      "description": "Read-only connection verification document checked on application startup via getDocFromServer",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 64 },
        "service": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["status"]
    },
    "MedicineItem": {
      "title": "Medicine Item Master Record",
      "description": "Pharmacy catalog item synchronized non-destructively between IndexedDB, SQLite, and Firestore",
      "type": "object",
      "properties": {
        "syncKey": { "type": "string", "maxLength": 64 },
        "cloudDocId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "localId": { "type": "number" },
        "serverId": { "type": "number" },
        "item_code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "company_name": { "type": "string", "maxLength": 120 },
        "item_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "generic_name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 80 },
        "packing": { "type": "string", "maxLength": 60 },
        "barcode": { "type": "string", "maxLength": 80 },
        "purchase_price": { "type": "number" },
        "trade_price": { "type": "number" },
        "wholesale_price": { "type": "number" },
        "retail_price": { "type": "number" },
        "loose_rate": { "type": "number" },
        "discount_percent": { "type": "number" },
        "tax_percent": { "type": "number" },
        "opening_stock": { "type": "number" },
        "minimum_stock": { "type": "number" },
        "rack_number": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "deviceId": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["syncKey", "cloudDocId", "item_code", "item_name", "status", "createdAt", "updatedAt"]
    },
    "SalesInvoice": {
      "title": "Sales Invoice Record",
      "description": "POS & Wholesale Sales Invoice synchronized non-destructively between IndexedDB, SQLite, and Firestore",
      "type": "object",
      "properties": {
        "syncKey": { "type": "string", "maxLength": 64 },
        "cloudDocId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientTxId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "localId": { "type": "number" },
        "serverId": { "type": "number" },
        "invoice_number": { "type": "string", "minLength": 1, "maxLength": 64 },
        "invoice_date": { "type": "string", "maxLength": 32 },
        "customer_account_id": { "type": "number" },
        "customer_name": { "type": "string", "maxLength": 160 },
        "customer_filer_status": { "type": "string", "maxLength": 32 },
        "salesman": { "type": "string", "maxLength": 120 },
        "invoice_type": { "type": "string", "maxLength": 40 },
        "payment_mode": { "type": "string", "maxLength": 40 },
        "gross_total": { "type": "number" },
        "discount_total": { "type": "number" },
        "tax_total": { "type": "number" },
        "net_total": { "type": "number" },
        "paid_amount": { "type": "number" },
        "balance_amount": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "held", "draft", "cancelled", "Completed", "Held", "Draft", "Cancelled"] },
        "remarks": { "type": "string", "maxLength": 500 },
        "items": { "type": "array" },
        "item_count": { "type": "number" },
        "deviceId": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["syncKey", "cloudDocId", "clientTxId", "invoice_number", "net_total", "status", "items", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/ams_cloud_snapshots/{docId}": {
      "schema": "CloudSnapshotMeta",
      "description": "Stores primary_meta and chunk_N documents for Abrar Medical Store SQLite snapshot persistence"
    },
    "/ams_erp_snapshots/{docId}": {
      "schema": "CloudSnapshotMeta",
      "description": "Legacy snapshot mirror collection for Abrar Medical Store ERP"
    },
    "/test/{docId}": {
      "schema": "ConnectionProbe",
      "description": "Boot connection check document at /test/connection"
    },
    "/items/{itemId}": {
      "schema": "MedicineItem",
      "description": "Live pharmacy medicine catalog items synchronized with offline IndexedDB and SQLite"
    },
    "/invoices/{invoiceId}": {
      "schema": "SalesInvoice",
      "description": "Live sales invoices synchronized with offline IndexedDB and SQLite"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HARDENED GLOBAL HELPERS ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isStoreSyncAuthorizedWrite() {
      return (isSignedIn() && request.auth.token.email_verified == true)
        || incoming().syncKey == 'ams_erp_cloud_sync_v2_2026';
    }

    function isStoreSyncAuthorizedGet() {
      return (isSignedIn() && request.auth.token.email_verified == true)
        || resource == null
        || resource.data.syncKey == 'ams_erp_cloud_sync_v2_2026';
    }

    function isStoreSyncAuthorizedList() {
      return (isSignedIn() && request.auth.token.email_verified == true)
        || resource.data.syncKey == 'ams_erp_cloud_sync_v2_2026';
    }

    function isValidTimestampStr(val) {
      return val is string && val.size() >= 10 && val.size() <= 64;
    }

    function isValidItem(data) {
      return data.keys().hasAll(['syncKey', 'cloudDocId', 'item_code', 'item_name', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'syncKey', 'cloudDocId', 'localId', 'serverId',
          'item_code', 'company_name', 'item_name', 'generic_name',
          'category', 'packing', 'barcode',
          'purchase_price', 'trade_price', 'wholesale_price', 'retail_price', 'loose_rate',
          'discount_percent', 'tax_percent', 'opening_stock', 'minimum_stock',
          'rack_number', 'status', 'deviceId', 'createdAt', 'updatedAt'
        ])
        && data.syncKey is string && data.syncKey.size() <= 64
        && isValidId(data.cloudDocId)
        && data.item_code is string && data.item_code.size() >= 1 && data.item_code.size() <= 64
        && data.item_name is string && data.item_name.size() >= 1 && data.item_name.size() <= 200
        && data.status in ['Active', 'Inactive']
        && isValidTimestampStr(data.createdAt)
        && isValidTimestampStr(data.updatedAt)
        && (!('localId' in data) || data.localId is number)
        && (!('serverId' in data) || data.serverId is number)
        && (!('company_name' in data) || (data.company_name is string && data.company_name.size() <= 120))
        && (!('generic_name' in data) || (data.generic_name is string && data.generic_name.size() <= 200))
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && (!('packing' in data) || (data.packing is string && data.packing.size() <= 60))
        && (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 80))
        && (!('purchase_price' in data) || data.purchase_price is number)
        && (!('trade_price' in data) || data.trade_price is number)
        && (!('wholesale_price' in data) || data.wholesale_price is number)
        && (!('retail_price' in data) || data.retail_price is number)
        && (!('loose_rate' in data) || data.loose_rate is number)
        && (!('discount_percent' in data) || data.discount_percent is number)
        && (!('tax_percent' in data) || data.tax_percent is number)
        && (!('opening_stock' in data) || data.opening_stock is number)
        && (!('minimum_stock' in data) || data.minimum_stock is number)
        && (!('rack_number' in data) || (data.rack_number is string && data.rack_number.size() <= 60))
        && (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 80));
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['syncKey', 'cloudDocId', 'clientTxId', 'invoice_number', 'net_total', 'status', 'items', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'syncKey', 'cloudDocId', 'clientTxId', 'localId', 'serverId',
          'invoice_number', 'invoice_date', 'customer_account_id', 'customer_name',
          'customer_filer_status', 'salesman', 'invoice_type', 'payment_mode',
          'gross_total', 'discount_total', 'tax_total', 'net_total',
          'paid_amount', 'balance_amount', 'status', 'remarks',
          'items', 'item_count', 'deviceId', 'createdAt', 'updatedAt'
        ])
        && data.syncKey is string && data.syncKey.size() <= 64
        && isValidId(data.cloudDocId)
        && data.clientTxId is string && data.clientTxId.size() >= 1 && data.clientTxId.size() <= 128
        && data.invoice_number is string && data.invoice_number.size() >= 1 && data.invoice_number.size() <= 64
        && data.net_total is number
        && data.status in ['completed', 'held', 'draft', 'cancelled', 'Completed', 'Held', 'Draft', 'Cancelled']
        && data.items is list && data.items.size() <= 500 && (data.items.size() == 0 || data.items[0] is map)
        && isValidTimestampStr(data.createdAt)
        && isValidTimestampStr(data.updatedAt)
        && (!('localId' in data) || data.localId is number)
        && (!('serverId' in data) || data.serverId is number)
        && (!('invoice_date' in data) || (data.invoice_date is string && data.invoice_date.size() <= 32))
        && (!('customer_account_id' in data) || data.customer_account_id is number)
        && (!('customer_name' in data) || (data.customer_name is string && data.customer_name.size() <= 160))
        && (!('customer_filer_status' in data) || (data.customer_filer_status is string && data.customer_filer_status.size() <= 32))
        && (!('salesman' in data) || (data.salesman is string && data.salesman.size() <= 120))
        && (!('invoice_type' in data) || (data.invoice_type is string && data.invoice_type.size() <= 40))
        && (!('payment_mode' in data) || (data.payment_mode is string && data.payment_mode.size() <= 40))
        && (!('gross_total' in data) || data.gross_total is number)
        && (!('discount_total' in data) || data.discount_total is number)
        && (!('tax_total' in data) || data.tax_total is number)
        && (!('paid_amount' in data) || data.paid_amount is number)
        && (!('balance_amount' in data) || data.balance_amount is number)
        && (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 500))
        && (!('item_count' in data) || data.item_count is number)
        && (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 80));
    }

    // 1. Boot Connection Probe (/test/connection)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // 2. Medicine Items Collection (/items/{itemId})
    match /items/{itemId} {
      allow get: if isValidId(itemId) && isStoreSyncAuthorizedGet();
      allow list: if isStoreSyncAuthorizedList();
      allow create: if isValidId(itemId)
        && incoming().cloudDocId == itemId
        && isStoreSyncAuthorizedWrite()
        && isValidItem(incoming());
      allow update: if isValidId(itemId)
        && incoming().cloudDocId == existing().cloudDocId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt >= existing().updatedAt
        && isStoreSyncAuthorizedWrite()
        && isValidItem(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'localId', 'serverId', 'item_code', 'company_name', 'item_name',
          'generic_name', 'category', 'packing', 'barcode',
          'purchase_price', 'trade_price', 'wholesale_price', 'retail_price',
          'loose_rate', 'discount_percent', 'tax_percent', 'opening_stock',
          'minimum_stock', 'rack_number', 'status', 'deviceId', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 3. Sales Invoices Collection (/invoices/{invoiceId})
    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && isStoreSyncAuthorizedGet();
      allow list: if isStoreSyncAuthorizedList();
      allow create: if isValidId(invoiceId)
        && incoming().cloudDocId == invoiceId
        && isStoreSyncAuthorizedWrite()
        && isValidInvoice(incoming());
      allow update: if isValidId(invoiceId)
        && incoming().cloudDocId == existing().cloudDocId
        && incoming().clientTxId == existing().clientTxId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt >= existing().updatedAt
        && isStoreSyncAuthorizedWrite()
        && isValidInvoice(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'localId', 'serverId', 'invoice_number', 'invoice_date',
          'customer_account_id', 'customer_name', 'customer_filer_status',
          'salesman', 'invoice_type', 'payment_mode', 'gross_total',
          'discount_total', 'tax_total', 'net_total', 'paid_amount',
          'balance_amount', 'status', 'remarks', 'items', 'item_count',
          'deviceId', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 4. Legacy Server-Side SQLite Snapshot Persistence
    match /ams_cloud_snapshots/{docId} {
      allow get: if isValidId(docId) && isStoreSyncAuthorizedGet();
      allow list: if isStoreSyncAuthorizedList();
      allow create, update: if isValidId(docId)
        && incoming().syncKey == 'ams_erp_cloud_sync_v2_2026'
        && incoming().snapshotKey is string && incoming().snapshotKey.size() <= 64
        && incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
      allow delete: if false;
    }

    match /ams_erp_snapshots/{docId} {
      allow get: if isValidId(docId) && isStoreSyncAuthorizedGet();
      allow list: if isStoreSyncAuthorizedList();
      allow create, update: if isValidId(docId)
        && incoming().syncKey == 'ams_erp_cloud_sync_v2_2026'
        && incoming().snapshotKey is string && incoming().snapshotKey.size() <= 64
        && incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
      allow delete: if false;
    }
  }
}

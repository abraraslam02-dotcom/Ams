# Application Environment Configuration
PORT=3000

# Database Configuration (Permanent SQLite path in workspace data directory)
DATABASE_PATH=data/ams_medical.db

# Localization & Business Standards
APP_TIMEZONE=Asia/Karachi
APP_CURRENCY=PKR
APP_LOCALE=en-PK
COMPANY_NAME=Abrar Medical Store

# GEMINI_API_KEY: Optional Gemini AI API key (injected at runtime via Secrets panel)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Configuration (injected at runtime)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="ai_studio"
SQL_USER="ai_studio_user"
SQL_PASSWORD=""
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD=""
